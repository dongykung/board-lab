@backend_HostAddress = http://localhost:5250

# 실행: dotnet run --launch-profile http  (backend 폴더에서)
# 각 요청 위의 "Send Request" 를 클릭하면 실행됩니다.
# 아래 순서대로 1 -> 2 -> 3 -> 4 -> 5 클릭하면 전체 CRUD 흐름이 검증됩니다.

### 1. 글 작성 (201 Created + Location 헤더)
# @name createPost
POST {{backend_HostAddress}}/api/posts
Content-Type: application/json

{
  "title": "테스트 글",
  "content": "board-lab 게시판 API 테스트입니다."
}

### 2. 목록 조회 (최신순, 200 OK)
GET {{backend_HostAddress}}/api/posts
Accept: application/json

### 3. 단건 조회 - 호출할 때마다 viewCount 가 1씩 증가합니다 (200 OK)
# 위 1번 요청을 보낸 뒤라면 생성된 id 가 자동으로 들어갑니다.
GET {{backend_HostAddress}}/api/posts/{{createPost.response.body.id}}
Accept: application/json

### 4. 수정 - title / content 만 변경됩니다 (200 OK, updatedAt 채워짐)
PUT {{backend_HostAddress}}/api/posts/{{createPost.response.body.id}}
Content-Type: application/json

{
  "title": "수정된 제목",
  "content": "내용도 수정했습니다."
}

### 5. 삭제 (204 No Content)
DELETE {{backend_HostAddress}}/api/posts/{{createPost.response.body.id}}

### 6. 삭제 확인 - 방금 지운 글이라 404 가 떠야 정상입니다
GET {{backend_HostAddress}}/api/posts/{{createPost.response.body.id}}
Accept: application/json




@postId = 8

### 단건 조회 (id 직접 지정)
GET {{backend_HostAddress}}/api/posts/{{postId}}
Accept: application/json

### 수정 (id 직접 지정)
PUT {{backend_HostAddress}}/api/posts/{{postId}}
Content-Type: application/json

{
  "title": "직접 지정한 id 로 수정",
  "content": "본문 수정"
}

### 삭제 (id 직접 지정)
DELETE {{backend_HostAddress}}/api/posts/{{postId}}


###############################################################
# 에러 / 엣지 케이스
###############################################################

### 없는 글 조회 -> 404 Not Found
GET {{backend_HostAddress}}/api/posts/999999
Accept: application/json

### 없는 글 수정 -> 404 Not Found
PUT {{backend_HostAddress}}/api/posts/999999
Content-Type: application/json

{
  "title": "없는 글",
  "content": "404 가 떠야 정상입니다."
}

### 없는 글 삭제 -> 404 Not Found
DELETE {{backend_HostAddress}}/api/posts/999999

### int 라우트 제약 확인 - id 자리에 문자열 -> 404 (라우트 매칭 실패)
GET {{backend_HostAddress}}/api/posts/abc
Accept: application/json


###############################################################
# OpenAPI 문서 (Development 환경에서만 노출)
###############################################################

### OpenAPI 스키마 확인
GET {{backend_HostAddress}}/openapi/v1.json
Accept: application/json

###
